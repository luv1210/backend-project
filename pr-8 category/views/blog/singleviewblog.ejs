<%- include('../header') %>

<style>
/* Blog View Page - Enhanced CSS */

/* Page wrapper background */
.page-wrapper {
    background: linear-gradient(135deg, #667eea0d 0%, #764ba20d 100%);
    min-height: 100vh;
    padding-bottom: 40px;
}

/* Breadcrumb styling */
.page-breadcrumb {
    background: white;
    border-radius: 20px;
    padding: 25px;
    margin: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.page-title {
    font-size: 1.8rem;
    font-weight: 800;
    background: linear-gradient(135deg, #00b894 0%, #0984e3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    display: inline-block;
}

.page-title::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #00b894, #0984e3);
    border-radius: 2px;
}

.breadcrumb {
    background: none;
    padding: 0;
    margin: 0;
}

.breadcrumb-item a {
    color: #00b894;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
}

.breadcrumb-item a:hover {
    color: #0984e3;
    text-decoration: underline;
}

.breadcrumb-item.active {
    color: #2c3e50;
    font-weight: 600;
}

/* Container spacing */
.container-fluid {
    padding: 0 30px;
}

/* Image styling */
.blog-image {
    border-radius: 25px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    width: 100%;
    height: 500px;
    object-fit: cover;
    transition: all 0.6s ease;
    border: 5px solid white;
    position: relative;
    overflow: hidden;
}

.blog-image::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, rgba(0, 184, 148, 0.1), rgba(9, 132, 227, 0.1));
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
}

.blog-image:hover::before {
    opacity: 1;
}

.blog-image:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.25);
}

/* Content box */
.blog-content {
    background: linear-gradient(145deg, #ffffff, #f8f9fa);
    border-radius: 25px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.3);
    position: relative;
    overflow: hidden;
}

.blog-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #00b894 0%, #00cec9 50%, #0984e3 100%);
}

/* Title styling */
.blog-content h4 {
    color: #2c3e50;
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 30px;
    text-align: center;
    position: relative;
    padding-bottom: 20px;
}

.blog-content h4::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 4px;
    background: linear-gradient(90deg, #00b894, #0984e3);
    border-radius: 2px;
}

/* Blog details styling */
.blog-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.detail-item {
    background: white;
    padding: 20px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    border-left: 4px solid #00b894;
    transition: all 0.3s ease;
}

.detail-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 184, 148, 0.15);
}

.detail-label {
    font-weight: 600;
    color: #636e72;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.detail-label i {
    color: #00b894;
    font-size: 1rem;
}

.detail-value {
    color: #2c3e50;
    font-size: 1.1rem;
    font-weight: 600;
}

/* Status badge */
.status-badge {
    display: inline-block;
    padding: 6px 15px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.status-published {
    background: linear-gradient(135deg, #00b894 0%, #00cec9 100%);
    color: white;
    box-shadow: 0 5px 15px rgba(0, 184, 148, 0.3);
}

.status-draft {
    background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
    color: white;
    box-shadow: 0 5px 15px rgba(243, 156, 18, 0.3);
}

/* Divider styling */
hr {
    border: none;
    height: 2px;
    background: linear-gradient(90deg, transparent, #00b894, transparent);
    margin: 40px 0;
    border-radius: 1px;
}

/* Content section */
.content-section {
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    margin-top: 30px;
}

.content-label {
    font-size: 1.3rem;
    font-weight: 700;
    color: #2c3e50;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.content-label i {
    color: #00b894;
}

.content-text {
    color: #2c3e50;
    font-size: 1.1rem;
    line-height: 1.8;
    text-align: justify;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 15px;
    border-left: 4px solid #0984e3;
}

/* Action buttons */
.action-buttons {
    display: flex;
    gap: 15px;
    margin-top: 40px;
    padding-top: 30px;
    border-top: 2px dashed #e0e0e0;
}

.btn-outline-warning {
    background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
    border: none;
    color: white !important;
    padding: 14px 30px;
    border-radius: 15px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
}

.btn-outline-warning:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(243, 156, 18, 0.4);
    color: white;
}

.btn-outline-danger {
    background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
    border: none;
    color: white !important;
    padding: 14px 30px;
    border-radius: 15px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
}

.btn-outline-danger:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(231, 76, 60, 0.4);
    color: white;
}

/* Back to list link */
.back-link {
    display: inline-block;
    margin-top: 20px;
    color: #00b894;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.back-link:hover {
    color: #0984e3;
    text-decoration: underline;
    transform: translateX(-5px);
}

/* Animation */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.row.align-items-center {
    animation: fadeIn 0.8s ease-out;
}

/* Responsive Design */
@media (max-width: 992px) {
    .container-fluid {
        padding: 0 20px;
    }
    
    .blog-image {
        height: 400px;
        margin-bottom: 30px;
    }
    
    .blog-content {
        padding: 30px;
    }
    
    .blog-content h4 {
        font-size: 1.8rem;
    }
    
    .detail-item {
        padding: 15px;
    }
}

@media (max-width: 768px) {
    .page-breadcrumb {
        margin: 15px;
        padding: 20px;
    }
    
    .page-title {
        font-size: 1.5rem;
    }
    
    .container-fluid {
        padding: 0 15px;
    }
    
    .blog-image {
        height: 350px;
        border-radius: 20px;
    }
    
    .blog-content {
        padding: 25px;
        border-radius: 20px;
    }
    
    .blog-content h4 {
        font-size: 1.6rem;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }
    
    .blog-details {
        grid-template-columns: 1fr;
        gap: 15px;
    }
    
    .content-section {
        padding: 20px;
    }
    
    .content-text {
        padding: 15px;
        font-size: 1rem;
    }
    
    .action-buttons {
        flex-direction: column;
        gap: 15px;
    }
    
    .btn-outline-warning,
    .btn-outline-danger {
        width: 100%;
        padding: 12px 20px;
    }
}

@media (max-width: 576px) {
    .page-breadcrumb {
        margin: 10px;
        padding: 15px;
    }
    
    .blog-image {
        height: 300px;
        border-radius: 15px;
    }
    
    .blog-content {
        padding: 20px;
        border-radius: 15px;
    }
    
    .blog-content h4 {
        font-size: 1.4rem;
    }
    
    .detail-item {
        padding: 12px;
    }
    
    .detail-label {
        font-size: 0.8rem;
    }
    
    .detail-value {
        font-size: 1rem;
    }
    
    .content-section {
        padding: 15px;
        border-radius: 15px;
    }
    
    .content-text {
        padding: 12px;
        font-size: 0.95rem;
    }
}

/* Category chip */
.category-chip {
    display: inline-block;
    padding: 8px 20px;
    background: linear-gradient(135deg, #00b894 0%, #00cec9 100%);
    color: white;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: 5px;
    box-shadow: 0 5px 15px rgba(0, 184, 148, 0.3);
}

/* Date styling */
.date-display {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #636e72;
    font-size: 0.9rem;
}

.date-display i {
    color: #0984e3;
}

/* Author info */
.author-info {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 10px;
}

.author-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #00b894;
    box-shadow: 0 5px 15px rgba(0, 184, 148, 0.3);
}

.author-name {
    font-weight: 600;
    color: #2c3e50;
    font-size: 1.1rem;
}

/* Social sharing */
.social-sharing {
    display: flex;
    gap: 10px;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px dashed #e0e0e0;
}

.share-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1rem;
    transition: all 0.3s ease;
}

.share-btn:hover {
    transform: translateY(-3px) scale(1.1);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
}

.share-fb { background: #1877f2; }
.share-twitter { background: #1da1f2; }
.share-linkedin { background: #0077b5; }
.share-whatsapp { background: #25d366; }

/* Read time */
.read-time {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 15px;
    background: rgba(9, 132, 227, 0.1);
    color: #0984e3;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
    margin-top: 10px;
}

/* Print styles */
@media print {
    .blog-image {
        box-shadow: none;
        border: 1px solid #ddd;
    }
    
    .blog-content {
        box-shadow: none;
        border: 1px solid #ddd;
    }
    
    .action-buttons,
    .social-sharing,
    .back-link {
        display: none;
    }
}
</style>

<div class="page-wrapper">
  <div class="page-breadcrumb">
    <div class="row">
      <div class="col-12 d-flex no-block align-items-center">
        <h4 class="page-title">Blog</h4>
        <div class="ml-auto text-right">
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/blog/view-blog">Back</a></li>
              <li class="breadcrumb-item active" aria-current="page">View Blog</li>
            </ol>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <div class="container-fluid">
    <div class="row align-items-center">

      <!-- Image -->
      <div class="col-md-5 text-center mb-4">
        <img
          src="<%= blog.authorImage %>"
          alt="Title"
          height="400"
          width="350"
          class="blog-image"
        />
      </div>

      <!-- Content -->
      <div class="col-md-7">
        <div class="blog-content">
          <h4 class="text-center"><%= blog.title %></h4>

          <p class="card-text"><strong>Author:</strong> <%= blog.name %></p>
          <p class="card-text"><strong>Category:</strong> <%= blog.category %></p>
          <p class="card-text"><strong>Status:</strong> <%= blog.status %></p>
          <p class="card-text"><strong>Date:</strong> <%= blog.date %></p>

          <hr>

          <p class="card-text">
            <strong>Content:</strong> <br>
            <%= blog.content %>
          </p>

          <a href="/blog/edit-blog/<%= blog.id %>" class="btn btn-outline-warning">Edit Blog</a>
          <a href="/blog/delete-blog/<%= blog.id %>" class="btn btn-outline-danger">Delete Blog</a>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../footer') %>
