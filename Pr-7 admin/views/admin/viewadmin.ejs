<%- include('../header')%>


    <!-- ============================================================== -->
    <!-- ============================================================== -->
    <!-- Page wrapper  -->
    <!-- ============================================================== -->
    <div class="page-wrapper">
        <!-- ============================================================== -->
        <!-- Bread crumb and right sidebar toggle -->
        <!-- ============================================================== -->
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 d-flex no-block align-items-center">
                    <h4 class="page-title">admin</h4>
                    <div class="ml-auto text-right">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">admin</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
        <!-- ============================================================== -->
        <!-- End Bread crumb and right sidebar toggle -->
        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- Container fluid  -->
        <!-- ============================================================== -->
        <div class="container-fluid">
            <!-- ============================================================== -->
            <!-- Start Page Content -->
            <!-- ============================================================== -->
            <div class="row">
                <div class="col-12">

                    <div class="card">
                        <div class="card-body">

                            <div class="row justify-content-around align-items-center mb-5">
                                <div class="col-4">
                                    <h5 class="card-title">Admins details </h5>

                                </div>
                                <div class="col-4">
                                    <form action="">
                                        <div class="input-group">
                                            <input type="search" class="form-control" name="search">
                                            <button class="btn btn-outline-primary">search</button>


                                        </div>
                                    </form>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table id="zero_config" class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Profile</th>
                                            <th>
                                                Name
                                            </th>
                                            <th>Gender</th>
                                            <th>Contact</th>
                                            <th>Email</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <% admins.forEach((admin,i)=> {%>
                                            <tr class="align-middle">
                                                <td class="align-middle"><img src="<%=admin.profileImage%>"
                                                        class="rounded rounded-circle" width="50" height="50"
                                                        alt="<%=admin.firstname%>"></td>
                                                <td class="align-middle">
                                                    <%=admin.firstname%>
                                                        <%=admin.lastname%>
                                                </td>
                                                <td class="align-middle">
                                                    <%=admin.gender%>
                                                </td>
                                                <td class="align-middle">
                                                    <%=admin.contactNo%>
                                                </td>
                                                <td class="align-middle">
                                                    <%=admin.email%>
                                                </td>
                                                <td class="align-middle">
                                                    <a href="/admin/edit-admin/<%=admin.id%>"
                                                        class="btn btn-cyan btn-sm">Edit</a>
                                                    <a href="/admin/delete-admin/<%=admin.id%>"
                                                        class="btn btn-danger btn-sm">delete</a>
                                                </td>
                                            </tr>
                                            <%})%>

                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================================== -->
            <!-- End PAge Content -->
            <!-- ============================================================== -->
            <!-- ============================================================== -->
            <!-- Right sidebar -->
            <!-- ============================================================== -->
            <!-- .right-sidebar -->
            <!-- ============================================================== -->
            <!-- End Right sidebar -->
            <!-- ============================================================== -->
        </div>
        <!-- ============================================================== -->
        <!-- End Container fluid  -->
        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- footer -->
        <%- include('../footer')%>

        <!-- Add this in the <head> section of header.ejs -->
<style>
    /* Admin Dashboard Custom Styles */
    
    /* Card styling */
    .card {
        border-radius: 15px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-5px);
    }
    
    .card-title {
        color: #2c3e50;
        font-weight: 600;
        border-left: 4px solid #3498db;
        padding-left: 15px;
    }
    
    /* Table styling */
    .table {
        border-radius: 10px;
        overflow: hidden;
    }
    
    .table thead {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .table thead th {
        color: white;
        font-weight: 600;
        border: none;
        padding: 15px 12px;
    }
    
    .table tbody tr {
        transition: all 0.3s ease;
    }
    
    .table tbody tr:hover {
        background-color: rgba(52, 152, 219, 0.08);
        transform: scale(1.002);
        box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
    }
    
    .table-striped tbody tr:nth-of-type(odd) {
        background-color: rgba(236, 240, 241, 0.3);
    }
    
    /* Button styling */
    .btn-cyan {
        background: linear-gradient(45deg, #22d3ee, #0ea5e9);
        border: none;
        color: white;
        padding: 6px 20px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    
    .btn-cyan:hover {
        background: linear-gradient(45deg, #0ea5e9, #0284c7);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
        color: white;
    }
    
    .btn-danger {
        background: linear-gradient(45deg, #f87171, #ef4444);
        border: none;
        padding: 6px 20px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    
    .btn-danger:hover {
        background: linear-gradient(45deg, #ef4444, #dc2626);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }
    
    .btn-outline-primary {
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    
    .btn-outline-primary:hover {
        transform: translateY(-2px);
    }
    
    /* Search form styling */
    .input-group {
        border-radius: 10px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    }
    
    .form-control {
        border-radius: 10px 0 0 10px;
        border: 2px solid #e2e8f0;
        padding: 12px 20px;
        transition: all 0.3s ease;
    }
    
    .form-control:focus {
        border-color: #3498db;
        box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.2);
    }
    
    /* Profile image styling */
    .rounded-circle {
        border: 3px solid #f1f5f9;
        transition: all 0.3s ease;
        object-fit: cover;
    }
    
    .rounded-circle:hover {
        transform: scale(1.1);
        border-color: #3498db;
    }
    
    /* Action buttons container */
    .align-middle td:last-child {
        min-width: 150px;
    }
    
    /* Status badge styling (if you add status later) */
    .badge {
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 500;
    }
    
    /* Pagination styling (if you add pagination) */
    .pagination {
        margin-top: 20px;
    }
    
    .page-link {
        border-radius: 8px;
        margin: 0 5px;
        border: none;
        color: #64748b;
    }
    
    .page-item.active .page-link {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }
    
    /* Animation for table rows */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .table tbody tr {
        animation: fadeIn 0.5s ease-out;
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
        .card-body {
            padding: 15px;
        }
        
        .table-responsive {
            border-radius: 10px;
        }
        
        .btn {
            padding: 5px 15px;
            font-size: 14px;
        }
    }
</style>