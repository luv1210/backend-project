        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <form class="form-horizontal" action="/admin/update-admin/<%=admin.id%>" method="post" enctype="multipart/form-data">
                        <div class="card-body">
                            <h4 class="card-title yext-center">Update Admin</h4>
                            <div class="form-group row">
                                <label for="fname" class="col-sm-3 text-right control-label col-form-label">First Name</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" value="<%=admin.firstname%>" id="fname" name="firstname" placeholder="First Name Here">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="lname" class="col-sm-3 text-right control-label col-form-label">Last Name</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" value="<%=admin.lastname%>" id="lname" name="lastname" placeholder="Last Name Here">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="lname" class="col-sm-3 text-right control-label col-form-label">Email</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" value="<%=admin.email%>" id="lname" name="email" placeholder="Email Here">
                                    <div class="field-info">Email cannot be changed</div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="lname" class="col-sm-3 text-right control-label col-form-label">Password</label>
                                <div class="col-sm-9">
                                    <input type="password" disabled class="form-control" value="<%=admin.password%>" id="lname" name="password" placeholder="Password Here">
                                    <a href="/admin/reset-password/<%=admin.id%>" class="password-reset-link">
                                        <i class="fas fa-key me-1"></i>Reset Password
                                    </a>
                                </div>
                            </div>
                             <div class="form-group row">
                            <label class="col-sm-3 text-right control-label col-form-label">Gender</label>
                            <div class="col-md-9 d-flex">
                                <div class="custom-control custom-radio mx-3">
                                    <input type="radio" class="custom-control-input" name="gender" id="customControlValidation1" <%=admin.gender =="Male"?"checked":""%> value="Male" required>
                                    <label class="custom-control-label" for="customControlValidation1">Male</label>
                                </div>
                                 <div class="custom-control custom-radio">
                                    <input type="radio" class="custom-control-input" name="gender" id="customControlValidation2"<%=admin.gender =="Female"?"checked":""%> value="Female"  required>
                                    <label class="custom-control-label" for="customControlValidation2">Female</label>
                                </div>
                                 
                            </div>
                        </div>
                            <div class="form-group row">
                                <label for="cono1" class="col-sm-3 text-right control-label col-form-label">Contact No</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" id="cono1" value="<%=admin.contactNo%>" name="contactNo" placeholder="Contact No Here">
                                </div>
                            </div>

                             <div class="form-group row">
                                <label for="cono1" class="col-sm-3 text-right control-label col-form-label">Profile Image</label>
                                <div class="col-sm-9">
                                    <input type="file" class="form-control" id="cono1" name="profileImage" placeholder="Contact No Here">
                                    <div class="current-image-container">
                                        <span class="current-image-label">Current Image:</span>
                                        <img src="<%=admin.profileImage%>" height="100" width="100" alt="<%=admin.firstname%> <%=admin.lastname%>">
                                    </div>
                                    <div class="field-info">Leave empty to keep current image</div>
                                </div>
                            </div>
                          
                        </div>
                        <div class="border-top text-center">
                            <div class="card-body ">
                                <button type="submit" class="btn btn-primary">Update Admin</button>
                            </div>
                        </div>
                    </form>
                </div>

              

            </div>
        
        </div>
        <!-- editor -->
       
        <!-- ============================================================== -->
